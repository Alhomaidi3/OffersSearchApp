    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>online-shopping.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="online-shopping.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="MySql.Data" Version="9.6.0" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.2" />
  </ItemGroup>

</Project>